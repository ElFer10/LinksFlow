{
  "manifestVersion": 5,
  "id": "com.linksflow.indesign.bridge.dev",
  "name": "LinksFlow Bridge",
  "version": "0.1.0",
  "main": "index.js",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "linksFlowBridgePanel",
      "label": "LinksFlow Bridge",
      "minimumSize": {
        "width": 180,
        "height": 80
      },
      "maximumSize": {
        "width": 400,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 220,
        "height": 100
      },
      "preferredFloatingSize": {
        "width": 260,
        "height": 120
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
